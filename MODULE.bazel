"""Talos: open-source, local-first spatial security and automation platform."""

module(
    name = "talos",
    version = "0.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "yaml-cpp", version = "0.9.0.bcr.1")
bazel_dep(name = "sqlite3", version = "3.53.4")
bazel_dep(name = "libsodium", version = "1.0.19")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)

# cpp-httplib as plain HTTP: the registry module forces BoringSSL TLS support,
# but TLS is terminated in front of the hub (reverse proxy / Railway edge).
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "cpp-httplib",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "cpp-httplib",
    hdrs = ["httplib.h"],
    includes = ["."],
    visibility = ["//visibility:public"],
)
""",
    # The hub's slowloris guard (server/http_server.cc) overrides
    # Server::process_and_close_socket to give each connection a request-read
    # deadline and a per-peer cap; upstream declares that virtual private.
    patch_cmds = [
        "perl -pi -e 's/^(  virtual bool process_and_close_socket\\(socket_t sock\\);)$/protected:\\n$1\\nprivate:/' httplib.h",
        "grep -B1 '^  virtual bool process_and_close_socket(socket_t sock);$' httplib.h | grep -q '^protected:$'",
    ],
    sha256 = "4b91c970132cd140586ba880beab099fd16f0dc48425a5a60c418422c04d9fc1",
    strip_prefix = "cpp-httplib-0.46.0",
    urls = ["https://github.com/yhirose/cpp-httplib/archive/refs/tags/v0.46.0.tar.gz"],
)
