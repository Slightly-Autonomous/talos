load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:copts.bzl", "TALOS_PROTO_COPTS")

cc_library(
    name = "twin",
    srcs = [
        "devices.cc",
        "transport.cc",
        "world.cc",
    ],
    hdrs = [
        "backend.h",
        "devices.h",
        "transport.h",
        "world.h",
    ],
    copts = TALOS_PROTO_COPTS,
    visibility = ["//simulation:__subpackages__"],
    deps = [
        "//contracts/proto/talos/sim/v1:sim_cc_proto",
        "//core/events",
        "//core/execution",
        "//firmware/portable",
        "//simulation/base",
    ],
)

# L2: the portable firmware on the virtual board behind the same IDeviceBackend seam.
cc_library(
    name = "firmware_backend",
    srcs = ["firmware_device.cc"],
    hdrs = ["firmware_device.h"],
    copts = TALOS_PROTO_COPTS,
    visibility = ["//simulation:__subpackages__"],
    deps = [
        ":twin",
        "//firmware/bridge:hub_bridge",
        "//firmware/sim",
    ],
)
