CONFIG_IDF_TARGET="esp32h2"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# A/B app OTA (two OTA app partitions + otadata, spec §36) plus a 64 KiB working
# NVS and a separate never-erased NVS for the boot epoch and identity (partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Portable firmware is exception- and RTTI-free.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
# Console and the bench diag protocol on the built-in USB-serial-JTAG (the
# board's only USB port). UART0 (115200) is on the Tag-Connect J10 for the
# ROM boot log, flashing and recovery.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Brown-outs must reset and be reported (bench-test-plan S-P15/S-P16).
CONFIG_ESP_BROWNOUT_DET=y
# Task watchdog resets the chip (main.cc subscribes app_main and the runtime
# feeds it every step; it also reconfigures this at run time).
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
# Datagram frames over the console are ~1.5 KB on the stack (serial_link.h).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Board table: TL-SN-002 (ADR 0019) by default; sdkconfig.tl_sn_001 selects the archived board.
CONFIG_TALOS_BOARD_TL_SN_002=y
# Thread (ADR 0014, ADR 0019 amendment 2026-11-22): OpenThread on the native
# 802.15.4 radio as a Minimal Thread Device (sleepy end device by default).
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_RADIO_NATIVE=y
CONFIG_OPENTHREAD_MTD=y
CONFIG_OPENTHREAD_CLI=n
# eventfd backs the OpenThread mainloop.
CONFIG_VFS_SUPPORT_SELECT=y
# Automatic light sleep between steps (sleep_policy.h kLight) and radio sleep
# for the sleepy end device.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_IEEE802154_SLEEP_ENABLE=y
