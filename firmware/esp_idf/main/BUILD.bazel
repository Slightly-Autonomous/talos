load("@rules_cc//cc:defs.bzl", "cc_library")

# The TL-SN-001 board table is header-only, so host tests and the virtual board
# use exactly the wiring the ESP32 build uses.
cc_library(
    name = "board_tl_sn_001",
    hdrs = ["board_tl_sn_001.h"],
    visibility = ["//visibility:public"],
    deps = ["//firmware/portable"],
)

# TL-SN-002 (ADR 0019), the default ESP-IDF target (Kconfig TALOS_BOARD).
cc_library(
    name = "board_tl_sn_002",
    hdrs = ["board_tl_sn_002.h"],
    visibility = ["//visibility:public"],
    deps = ["//firmware/portable"],
)
