load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//bazel:copts.bzl", "TALOS_COPTS")

cc_library(
    name = "sim",
    srcs = ["virtual_board.cc"],
    hdrs = [
        "sim_faults.h",
        "virtual_board.h",
    ],
    copts = TALOS_COPTS,
    visibility = ["//visibility:public"],
    deps = [
        "//firmware/esp_idf/main:board_tl_sn_001",
        "//firmware/portable",
    ],
)

cc_library(
    name = "udp_datagram",
    srcs = ["udp_datagram.cc"],
    hdrs = ["udp_datagram.h"],
    copts = TALOS_COPTS,
    visibility = ["//visibility:public"],
    deps = ["//firmware/portable"],
)

cc_test(
    name = "node_test",
    size = "small",
    srcs = ["node_test.cc"],
    copts = TALOS_COPTS,
    deps = [
        ":sim",
        "//common/sha256",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "node_hub_test",
    size = "small",
    srcs = ["node_hub_test.cc"],
    copts = TALOS_COPTS,
    deps = [
        "//firmware/bridge:hub_bridge",
        ":sim",
        "//core/engine",
        "//core/testing:fixtures",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "diag_test",
    size = "small",
    srcs = ["diag_test.cc"],
    copts = TALOS_COPTS,
    deps = [
        ":sim",
        "@googletest//:gtest_main",
    ],
)

# The bench console on the virtual board: what tools/bench drives in CI before
# any board exists. stdin: diag commands, or "sim ..." fault-injection lines.
cc_binary(
    name = "bench_node",
    srcs = ["bench_node.cc"],
    copts = TALOS_COPTS,
    visibility = ["//visibility:public"],
    deps = [":sim"],
)
