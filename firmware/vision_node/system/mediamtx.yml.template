# TL-VN-001 camera stream (ADR 0020), MediaMTX v1.21. Rendered onto the SD card by
# tools/provision/vision_node.py: @RTSP_PASSWORD@ is replaced there, never committed.
# Keys follow MediaMTX's reference mediamtx.yml; check them when upgrading MediaMTX.
logLevel: info

# Local control API for the Talos agent only.
api: true
apiAddress: 127.0.0.1:9997
metrics: false
pprof: false
playback: false

rtsp: true
rtspAddress: :8554
rtspTransports: [tcp]
rtmp: false
hls: false
webrtc: false
srt: false
moq: false

authMethod: internal
authInternalUsers:
  # Frigate reads the stream with the per-camera password, over the LAN.
  - user: talos
    pass: "@RTSP_PASSWORD@"
    ips: []
    permissions:
      - action: read
        path: cam
      - action: read
        path: detect
  # The agent on this Pi: the API, from localhost only.
  - user: any
    pass:
    ips: ["127.0.0.1", "::1"]
    permissions:
      - action: api

paths:
  # Main stream: hardware H.264 (VideoCore IV), recorded by Frigate and used for detection.
  cam:
    source: rpiCamera
    rpiCameraCamID: 0
    rpiCameraWidth: 1920
    rpiCameraHeight: 1080
    rpiCameraFPS: 15
    rpiCameraCodec: h264
    rpiCameraBitrate: 4000000
    rpiCameraIDRPeriod: 30
    rpiCameraAfMode: continuous
    rpiCameraHDR: false
    # Camera Module 3 Wide NoIR: corrects part of the daytime colour shift (VB-07).
    rpiCameraTuningFile: /usr/share/libcamera/ipa/rpi/vc4/imx708_wide_noir.json
  # Optional 640x360 detection stream (MJPEG, the secondary stream of the same camera). Off until
  # VB-08 shows the Zero 2 W holds both; enable with provision --detect-stream.
  # @DETECT_STREAM_BEGIN@
  # detect:
  #   source: rpiCamera
  #   rpiCameraCamID: 0
  #   rpiCameraSecondary: true
  #   rpiCameraWidth: 640
  #   rpiCameraHeight: 360
  #   rpiCameraFPS: 5
  # @DETECT_STREAM_END@
