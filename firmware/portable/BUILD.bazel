load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//bazel:copts.bzl", "TALOS_COPTS")

# Portable device firmware: host (tests, twin) and ESP32-H2 (ESP-IDF) build
# the same sources. No heap in hot paths, no exceptions, no RTTI: the host
# build enforces the last two the way the ESP-IDF build does
# (CONFIG_COMPILER_CXX_EXCEPTIONS=n, CONFIG_COMPILER_CXX_RTTI=n).
PORTABLE_COPTS = TALOS_COPTS + [
    "-fno-exceptions",
    "-fno-rtti",
]

cc_library(
    name = "portable",
    srcs = [
        "board_io.cc",
        "coap_link.cc",
        "diag.cc",
        "modules.cc",
        "ota.cc",
        "runtime.cc",
        "serial_link.cc",
        "wire.cc",
    ],
    hdrs = [
        "board_io.h",
        "coap_link.h",
        "diag.h",
        "event_queue.h",
        "hal.h",
        "modules.h",
        "ota.h",
        "runtime.h",
        "serial_link.h",
        "types.h",
        "wire.h",
    ],
    copts = PORTABLE_COPTS,
    visibility = ["//visibility:public"],
    deps = [
        "//common/coap",
        "//common/sha256",
    ],
)

cc_test(
    name = "wire_test",
    size = "small",
    srcs = ["wire_test.cc"],
    copts = TALOS_COPTS,
    deps = [
        ":portable",
        "//common/sha256",
        "@googletest//:gtest_main",
    ],
)
