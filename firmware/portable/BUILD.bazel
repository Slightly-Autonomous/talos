load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//bazel:copts.bzl", "TALOS_COPTS")

# Portable device firmware: host (tests, twin) and ESP32-H2 (ESP-IDF) build
# the same sources. No heap in hot paths, no exceptions, no RTTI. The host
# build enforces no exceptions (CONFIG_COMPILER_CXX_EXCEPTIONS=n on the ESP).
# RTTI stays on here: UBSan's vptr check needs typeinfo for these classes when
# host targets link them, and the ESP-IDF CI build (CONFIG_COMPILER_CXX_RTTI=n)
# already fails on any dynamic_cast or typeid in portable code.
PORTABLE_COPTS = TALOS_COPTS + [
    "-fno-exceptions",
]

cc_library(
    name = "portable",
    srcs = [
        "board_io.cc",
        "coap_link.cc",
        "diag.cc",
        "modules.cc",
        "ota.cc",
        "runtime.cc",
        "serial_link.cc",
        "wire.cc",
    ],
    hdrs = [
        "board_io.h",
        "coap_link.h",
        "diag.h",
        "event_queue.h",
        "hal.h",
        "modules.h",
        "ota.h",
        "runtime.h",
        "serial_link.h",
        "types.h",
        "wire.h",
    ],
    copts = PORTABLE_COPTS,
    visibility = ["//visibility:public"],
    deps = [
        "//common/coap",
        "//common/sha256",
    ],
)

cc_test(
    name = "wire_test",
    size = "small",
    srcs = ["wire_test.cc"],
    copts = TALOS_COPTS,
    deps = [
        ":portable",
        "//common/sha256",
        "@googletest//:gtest_main",
    ],
)
