load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//bazel:copts.bzl", "TALOS_COPTS")

# Portable device firmware: host (tests, twin) and ESP32-H2 (ESP-IDF) build
# the same sources. No heap in hot paths, no exceptions, no RTTI.
cc_library(
    name = "portable",
    srcs = [
        "coap_link.cc",
        "modules.cc",
        "ota.cc",
        "runtime.cc",
        "wire.cc",
    ],
    hdrs = [
        "coap_link.h",
        "event_queue.h",
        "hal.h",
        "modules.h",
        "ota.h",
        "runtime.h",
        "types.h",
        "wire.h",
    ],
    copts = TALOS_COPTS,
    visibility = ["//visibility:public"],
    deps = [
        "//common/coap",
        "//common/sha256",
    ],
)

cc_test(
    name = "wire_test",
    size = "small",
    srcs = ["wire_test.cc"],
    copts = TALOS_COPTS,
    deps = [
        ":portable",
        "//common/sha256",
        "@googletest//:gtest_main",
    ],
)
