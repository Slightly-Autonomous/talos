load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")

proto_library(
    name = "api_proto",
    srcs = glob(["*.proto"]),
    strip_import_prefix = "/contracts/proto",
    visibility = ["//visibility:public"],
    deps = [
        "//contracts/proto/talos/server/v1:server_proto",
        "//contracts/proto/talos/v1:talos_proto",
    ],
)

cc_proto_library(
    name = "api_cc_proto",
    visibility = ["//visibility:public"],
    deps = [":api_proto"],
)
