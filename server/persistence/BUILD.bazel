load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//bazel:copts.bzl", "TALOS_PROTO_COPTS")

cc_library(
    name = "persistence",
    srcs = [
        "config_store.cc",
        "sqlite_journal.cc",
    ],
    hdrs = [
        "config_store.h",
        "sqlite_journal.h",
    ],
    copts = TALOS_PROTO_COPTS,
    visibility = ["//server:__subpackages__"],
    deps = [
        "//codec",
        "//core/base",
        "//contracts/proto/talos/server/v1:server_cc_proto",
        "//core/journal",
        "//server:sha256",
        "@sqlite3",
    ],
)

cc_test(
    name = "sqlite_journal_test",
    size = "small",
    srcs = ["sqlite_journal_test.cc"],
    copts = TALOS_PROTO_COPTS,
    deps = [
        ":persistence",
        "//core/journal:conformance",
        "@googletest//:gtest_main",
        "@sqlite3",
    ],
)
